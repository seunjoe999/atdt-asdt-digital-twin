# --- ASDT service configuration ---

DATABASE_URL=sqlite:///./asdt.db

# Where the ATDT service is reachable. ASDT never shares a database or a
# secret key with ATDT — it is a genuinely separate service that only talks
# to ATDT's public HTTP API (the CDDT "API endpoint separation" principle,
# thesis Section 2.6). It authenticates each call by forwarding the caller's
# own ATDT bearer token, i.e. the student's ASDT literally acts *as* the
# student when it talks to ATDT.
ATDT_BASE_URL=http://localhost:8000

# Mastery below this (0-1) on a topic counts as a "gap" worth negotiating
# remediation for.
GAP_THRESHOLD=0.6
