# --- ATDT backend configuration ---

# SQLite by default (zero setup). Swap to Postgres for production, matching
# the thesis's stated stack, e.g.:
# DATABASE_URL=postgresql+psycopg://atdt:atdt@localhost:5432/atdt
DATABASE_URL=sqlite:///./atdt.db

# Signing key for JWT access tokens. Generate your own for anything beyond a
# local demo: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-dev-only-not-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Where the local ChromaDB persistent store lives on disk.
CHROMA_DIR=./chroma_data

# OpenAI key used for embeddings (text-embedding-3-small, per the thesis) and,
# if DT_LLM__PROVIDER=openai below, for generation too. Leave blank to fall
# back to an offline hashing embedder — ingestion and retrieval still work,
# just with weaker semantic matching, useful for a demo without a key.
OPENAI_API_KEY=

# --- dyon: the agent/LLM layer (Chapter 3.5, "Agent Orchestrator") ---
# Provider-agnostic LLM selection, read by dyon.core.config.TwinConfig.
# provider: openai | anthropic | ollama | offline
# "offline" needs no key and no network — every channel (Teaching, Tutoring,
# Examination) still runs end to end, generating clearly-labelled offline
# placeholder text instead of real model output. Good for a first run before
# you have a key.
DT_LLM__PROVIDER=offline
DT_LLM__MODEL=gpt-4o
DT_LLM__API_KEY=
DT_LLM__TEMPERATURE=0.2
DT_LLM__TIMEOUT_S=60
DT_LLM__MAX_TOKENS=2048
# For DT_LLM__PROVIDER=ollama:
# DT_LLM__BASE_URL=http://localhost:11434
